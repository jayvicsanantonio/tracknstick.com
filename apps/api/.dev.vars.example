# Local secrets for `wrangler dev`. Copy to .dev.vars (gitignored) and fill in.
# Values here override the [vars] in wrangler.toml during local development.

# development: the CORS origins and Clerk authorized parties for localhost
ENVIRONMENT=development

# Optional (development only): comma-separated extra origins (e.g. a cloudflared tunnel URL)
# EXTRA_ALLOWED_ORIGINS=https://your-tunnel.trycloudflare.com

# Clerk development instance keys (Dashboard > API keys, Development)
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Optional: only the chat endpoint's retrieval uses it
PINECONE_API_KEY=
